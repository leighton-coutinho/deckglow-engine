{
  "schema": "deckglow.scene-module/1",
  "id": "com.deckglow.kinetic_stripes",
  "type": "base_scene",
  "displayName": "Kinetic Stripes",
  "author": "DeckGlow",
  "version": "1.1.0",
  "runtimeApi": ">=2.0.0 <3.0.0",
  "entry": "module.tox",
  "thumbnail": "thumbnail.png",
  "performanceTier": "light",
  "tags": ["geometric", "high-contrast", "stripes"],
  "controls": [
    {
      "parameter": "Stripeperiod",
      "label": "Stripe Period",
      "type": "float",
      "min": 0.1,
      "max": 2.0,
      "default": 0.54,
      "group": "Shape"
    },
    {
      "parameter": "Stripeshift",
      "label": "Stripe Shift",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "default": 1.0,
      "group": "Motion"
    },
    {
      "parameter": "Flash",
      "label": "Flash",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "default": 1.25,
      "group": "Response"
    },
    {
      "parameter": "Barzoom",
      "label": "Bar Zoom",
      "type": "float",
      "min": 0.0,
      "max": 1.5,
      "default": 1.0,
      "group": "Response"
    },
    {
      "parameter": "Kickzoom",
      "label": "Kick Zoom",
      "type": "float",
      "min": 0.0,
      "max": 0.5,
      "default": 0.12,
      "group": "Response"
    },
    {
      "parameter": "Beatdrift",
      "label": "Beat Drift",
      "type": "float",
      "min": 0.0,
      "max": 0.1,
      "default": 0.03,
      "group": "Motion"
    }
  ],
  "description": "Beat-reactive greyscale-to-yellow stripes: they slide with body energy, flash on hits, zoom on bars and kicks, and drift with the beat. Static stripes at idle.",
  "capabilities": {
    "usesPython": false,
    "usesAudioFileIn": false,
    "supportsAlphaAssets": false
  }
}
