{
  "schema": "deckglow.scene-module/1",
  "id": "com.deckglow.orb_burst",
  "type": "hit_fx",
  "displayName": "Orb Burst",
  "author": "DeckGlow",
  "version": "1.0.0",
  "runtimeApi": ">=2.0.0 <3.0.0",
  "entry": "module.tox",
  "thumbnail": "thumbnail.png",
  "performanceTier": "light",
  "tags": ["orbs", "burst", "palette"],
  "controls": [
    {
      "parameter": "Ballsize",
      "label": "Ball Size",
      "type": "float",
      "min": 0.02,
      "max": 0.4,
      "default": 0.12,
      "group": "Shape"
    },
    {
      "parameter": "Lifetime",
      "label": "Lifetime",
      "type": "float",
      "min": 0.1,
      "max": 3.0,
      "default": 0.8,
      "group": "Emission"
    },
    {
      "parameter": "Spawncount",
      "label": "Balls Per Hit",
      "type": "integer",
      "min": 1,
      "max": 12,
      "default": 4,
      "group": "Emission"
    },
    {
      "parameter": "Spread",
      "label": "Spread",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.6,
      "group": "Emission"
    },
    {
      "parameter": "Softness",
      "label": "Softness",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "group": "Shape"
    }
  ],
  "description": "Soft palette-coloured orbs that burst on each hit and fade over their lifetime. A fixed pool of 32 orbs; brightness follows the hit's strength.",
  "capabilities": {
    "usesPython": true,
    "usesAudioFileIn": false,
    "supportsAlphaAssets": false
  }
}
